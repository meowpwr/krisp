# Supabase CLI credentials for `make dev-push` / `make prod-push`.
# Copy this file to `.env` (which is gitignored) and fill in the values.
#
#   cp .env.example .env
#
# Personal access token — create at https://supabase.com/dashboard/account/tokens
# Lets the CLI authenticate without an interactive `supabase login`.
SUPABASE_ACCESS_TOKEN=

# Database passwords — the ones you set when each project was created.
# (Dashboard → Project Settings → Database → Reset database password, if forgotten.)
DEV_DB_PASSWORD=
PROD_DB_PASSWORD=
